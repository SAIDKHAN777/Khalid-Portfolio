---
import '../styles/global.css';

export interface Props {
  title?: string;
  activeTab?: string;
}

const { title = 'Admin Dashboard | Khalid Portfolio', activeTab = 'dashboard' } = Astro.props;
const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/admin/login');
}

const navItems = [
  {
    id: 'dashboard',
    label: 'Dashboard',
    href: '/admin/dashboard',
    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  },
  {
    id: 'settings',
    label: 'Hero & About',
    href: '/admin/settings',
    icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z',
  },
  {
    id: 'works',
    label: 'Works Studio',
    href: '/admin/works',
    icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  },
  {
    id: 'blog',
    label: 'Press & Articles',
    href: '/admin/blog',
    icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z',
  },
  {
    id: 'messages',
    label: 'Contact Inquiries',
    href: '/admin/messages',
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#FCFCFC] text-[#101014] flex flex-col md:flex-row antialiased selection:bg-[#101014] selection:text-white">
    <!-- Black Sidebar Navigation -->
    <aside class="w-full md:w-64 bg-[#101014] text-white border-r border-neutral-800 flex flex-col justify-between shrink-0">
      <div>
        <!-- Brand Header -->
        <div class="px-6 py-5 border-b border-neutral-800 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-white text-[#101014] flex items-center justify-center shadow font-extrabold text-sm">
              K
            </div>
            <div>
              <span class="block font-bold text-sm text-white leading-tight">Khalid Portfolio</span>
              <span class="block text-[11px] text-neutral-400 font-mono flex items-center gap-1.5 mt-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                Admin CMS Active
              </span>
            </div>
          </div>
        </div>

        <!-- Navigation Links -->
        <nav class="p-3 space-y-1">
          {navItems.map((item) => {
            const isActive = activeTab === item.id;
            return (
              <a
                href={item.href}
                class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all ${
                  isActive
                    ? 'bg-white text-[#101014] shadow-sm'
                    : 'text-neutral-400 hover:text-white hover:bg-neutral-900'
                }`}
              >
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                </svg>
                {item.label}
              </a>
            );
          })}
        </nav>
      </div>

      <!-- Live Preview & User Footer -->
      <div class="p-4 border-t border-neutral-800 space-y-3">
        <!-- Live Preview Button -->
        <a
          href="/?preview=true"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl bg-neutral-900 hover:bg-neutral-800 border border-neutral-700 text-xs font-bold text-white transition group"
        >
          <span>Live Preview (Drafts)</span>
          <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <div class="flex items-center justify-between pt-2">
          <div class="truncate pr-2">
            <p class="text-xs font-bold text-white truncate">{user?.name || 'Khalid'}</p>
            <p class="text-[11px] text-neutral-400 truncate">{user?.email}</p>
          </div>
          <button
            id="admin-logout-btn"
            class="p-2 rounded-lg text-neutral-400 hover:text-white hover:bg-neutral-800 transition cursor-pointer"
            title="Log out"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
          </button>
        </div>
      </div>
    </aside>

    <!-- Main Content Area with Pure White Background -->
    <div class="flex-1 flex flex-col min-w-0 overflow-y-auto bg-[#FCFCFC]">
      <main class="flex-1 p-6 md:p-10 max-w-7xl w-full mx-auto space-y-8">
        <slot />
      </main>
    </div>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <script>
      // Global Toast Utility
      (window as any).showToast = (message: string, type: 'success' | 'error' = 'success') => {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `px-4 py-3 rounded-xl text-xs font-semibold shadow-2xl pointer-events-auto flex items-center gap-2 transition-all transform duration-300 ${
          type === 'success'
            ? 'bg-[#101014] text-white border border-neutral-700'
            : 'bg-red-950 text-white border border-red-800'
        }`;
        toast.innerHTML = `<span>${type === 'success' ? '✓' : '⚠'}</span><span>${message}</span>`;
        container.appendChild(toast);

        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(10px)';
          setTimeout(() => toast.remove(), 300);
        }, 3500);
      };

      // Logout handler
      document.getElementById('admin-logout-btn')?.addEventListener('click', async () => {
        try {
          await fetch('/api/auth/logout', { method: 'POST' });
        } finally {
          window.location.href = '/admin/login';
        }
      });
    </script>
  </body>
</html>
