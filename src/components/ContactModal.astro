---
// ContactModal.astro: Elegant, pure-white modal contact form matching Khalid's specifications
---

<dialog
  id="contact-modal"
  class="fixed inset-0 z-50 m-auto p-0 bg-transparent backdrop:bg-black/60 backdrop:backdrop-blur-sm max-w-2xl w-[92vw] border-0 focus:outline-none select-none transition-all duration-300"
  aria-modal="true"
  aria-labelledby="contact-modal-title"
>
  <div class="relative bg-[#FCFCFC] text-[#101014] rounded-2xl md:rounded-3xl shadow-2xl border border-[#E4E4E8] p-6 sm:p-10 md:p-12 overflow-hidden">
    <!-- Close Button (Top Right) -->
    <button
      type="button"
      id="contact-modal-close"
      class="absolute top-5 right-5 sm:top-6 sm:right-6 text-[#101014]/50 hover:text-[#101014] p-2 rounded-full hover:bg-black/5 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
      aria-label="Close Contact Form"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Header -->
    <div class="mb-8 text-left">
      <h3 id="contact-modal-title" class="text-2xl sm:text-4xl font-bold tracking-tight text-[#101014]">
        Let's Make It Happen
      </h3>
      <p class="text-slate-500 text-sm sm:text-base mt-2">
        Leave your details and project requirements below.
      </p>
    </div>

    <!-- Contact Form -->
    <form id="contact-form" class="space-y-6 text-left">
      <!-- Hidden Honeypot for spam bot detection -->
      <input type="text" name="honeypot" id="contact-honeypot" class="hidden" tabindex="-1" autocomplete="off" />

      <!-- 1. Name Field (Name on side, clean line) -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6 border-b border-[#101014]/25 focus-within:border-[#101014] py-3.5 transition-colors">
        <label for="contact-name" class="w-24 text-base sm:text-lg font-bold text-[#101014] tracking-tight shrink-0 select-none">
          Name
        </label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          minlength="2"
          maxlength="100"
          placeholder="Your full name"
          class="flex-1 bg-transparent text-base sm:text-lg text-[#101014] placeholder-[#101014]/30 focus:outline-none py-1"
        />
      </div>

      <!-- 2. Email Field (Email on side, clean line) -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6 border-b border-[#101014]/25 focus-within:border-[#101014] py-3.5 transition-colors">
        <label for="contact-email" class="w-24 text-base sm:text-lg font-bold text-[#101014] tracking-tight shrink-0 select-none">
          Email
        </label>
        <input
          type="email"
          id="contact-email"
          name="email"
          required
          placeholder="your.email@example.com"
          class="flex-1 bg-transparent text-base sm:text-lg text-[#101014] placeholder-[#101014]/30 focus:outline-none py-1"
        />
      </div>

      <!-- 3. Project / Requirements Field -->
      <div class="flex flex-col gap-2 border-b border-[#101014]/25 focus-within:border-[#101014] py-3.5 transition-colors">
        <label for="contact-message" class="text-base sm:text-lg font-bold text-[#101014] tracking-tight select-none">
          Project / Requirements
        </label>
        <textarea
          id="contact-message"
          name="message"
          required
          minlength="10"
          maxlength="5000"
          rows="4"
          placeholder="Write your project details, requirements, questions, or whatever you have in mind..."
          class="w-full bg-transparent text-base sm:text-lg text-[#101014] placeholder-[#101014]/30 focus:outline-none resize-none py-1 leading-relaxed"
        ></textarea>
      </div>

      <!-- Submit Button and Status Notice -->
      <div class="pt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <button
          type="submit"
          id="contact-submit-btn"
          class="w-full sm:w-auto px-10 py-3.5 rounded-full bg-[#101014] text-white text-base font-semibold tracking-wide hover:bg-black/85 active:scale-98 transition-all duration-200 cursor-pointer shadow-md disabled:opacity-50"
        >
          <span>Submit</span>
        </button>

        <div id="contact-status-msg" class="text-sm font-medium transition-all duration-300 hidden"></div>
      </div>
    </form>
  </div>
</dialog>

<script>
  function initContactModal() {
    const modal = document.getElementById('contact-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('contact-modal-close');
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
    const statusMsg = document.getElementById('contact-status-msg');

    if (!modal || !form || !submitBtn) return;

    // Open modal triggers: buttons or links with .open-contact-modal or href="/#footer" or href="#contact"
    const openModal = () => {
      modal.showModal();
      document.body.classList.add('overflow-hidden');
      const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
      if (nameInput) nameInput.focus();
    };

    const closeModal = () => {
      modal.close();
      document.body.classList.remove('overflow-hidden');
    };

    document.querySelectorAll('.open-contact-modal').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    // Also attach to footer contact button
    const footerContactBtn = document.querySelector('#footer .shape-contact-btn');
    if (footerContactBtn) {
      footerContactBtn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }

    // Close when clicking directly on dialog backdrop
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on Escape key
    modal.addEventListener('cancel', () => {
      document.body.classList.remove('overflow-hidden');
    });

    // Form Submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
      const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
      const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;
      const honeypotInput = document.getElementById('contact-honeypot') as HTMLInputElement | null;

      const name = nameInput?.value.trim() || '';
      const email = emailInput?.value.trim() || '';
      const message = messageInput?.value.trim() || '';
      const honeypot = honeypotInput?.value || '';

      if (name.length < 2) {
        showStatus('Name must be at least 2 characters.', 'error');
        return;
      }
      if (!email.includes('@')) {
        showStatus('Please enter a valid email address.', 'error');
        return;
      }
      if (message.length < 10) {
        showStatus('Please write at least 10 characters for your project requirements.', 'error');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerText = 'Sending...';
      hideStatus();

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            email,
            subject: 'Project Requirement Inquiry',
            message,
            honeypot,
          }),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          showStatus('Thank you! Your requirements have been submitted successfully.', 'success');
          form.reset();
          setTimeout(() => {
            closeModal();
            hideStatus();
          }, 2400);
        } else {
          showStatus(data.error?.message || 'Failed to submit. Please try again.', 'error');
        }
      } catch (err) {
        showStatus('Network error. Please try again.', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerText = 'Submit';
      }
    });

    function showStatus(text: string, type: 'success' | 'error') {
      if (!statusMsg) return;
      statusMsg.textContent = text;
      statusMsg.classList.remove('hidden', 'text-emerald-600', 'text-red-500');
      statusMsg.classList.add(type === 'success' ? 'text-emerald-600' : 'text-red-500');
    }

    function hideStatus() {
      if (!statusMsg) return;
      statusMsg.classList.add('hidden');
      statusMsg.textContent = '';
    }
  }

  // Initialize on load and on page changes
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactModal);
  } else {
    initContactModal();
  }
</script>
