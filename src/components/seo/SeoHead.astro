---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  twitterHandle?: string;
  siteName?: string;
  keywords?: string[];
}

const {
  title = 'Khalid | Senior Backend Engineer & System Architect',
  description = 'High-performance systems architecture, microservices, and distributed applications by Khalid.',
  image = '/images/og-default.png',
  canonicalUrl = Astro.url.href,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  author = 'Khalid',
  twitterHandle = '@khalid_dev',
  siteName = 'Khalid Portfolio',
  keywords = ['Software Engineer', 'System Architect', 'Backend Developer', 'Astro', 'PostgreSQL', 'Distributed Systems'],
} = Astro.props;

const robotsContent = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<meta name="author" content={author} />
<meta name="robots" content={robotsContent} />
<link rel="canonical" href={canonicalUrl} />

<!-- RSS Feed Discovery -->
<link rel="alternate" type="application/rss+xml" title={`${siteName} RSS Feed`} href="/rss.xml" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:site_name" content={siteName} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{author && <meta property="article:author" content={author} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:creator" content={twitterHandle} />
