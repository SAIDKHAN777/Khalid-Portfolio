---
export interface SocialProfileItem {
  id?: string;
  title?: string;
  url?: string;
  logoUrl?: string;
}

interface Props {
  profiles?: SocialProfileItem[];
  size?: 'sm' | 'md';
}

const { profiles = [], size = 'md' } = Astro.props;

const boxClass =
  size === 'sm'
    ? 'w-10 h-10 md:w-11 md:h-11 rounded-xl border border-[#E2E2E6] bg-white hover:bg-[#101014] hover:border-[#101014] flex items-center justify-center transition-all duration-300 shadow-xs group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#101014] cursor-pointer'
    : 'w-12 h-12 rounded-2xl border border-[#E2E2E6] bg-white hover:bg-[#101014] hover:border-[#101014] flex items-center justify-center transition-all duration-300 shadow-xs group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#101014] cursor-pointer';

const iconClass =
  size === 'sm'
    ? 'w-[18px] h-[18px] text-[#101014] group-hover:text-white transition duration-200'
    : 'w-5 h-5 text-[#101014] group-hover:text-white transition duration-200';

const imgClass =
  size === 'sm'
    ? 'w-[18px] h-[18px] object-contain filter grayscale contrast-200 group-hover:brightness-0 group-hover:invert transition duration-200'
    : 'w-5 h-5 object-contain filter grayscale contrast-200 group-hover:brightness-0 group-hover:invert transition duration-200';
---

{profiles.length > 0 && (
  <div class="social-links-row flex flex-wrap items-center gap-2.5 md:gap-3">
    {profiles.map((item) => {
      const lowerTitle = (item.title || '').toLowerCase().trim();
      const href = item.url || '#';
      return (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.title || 'Social Profile'}
          title={item.title || 'Social Profile'}
          class={boxClass}
        >
          {item.logoUrl ? (
            <img
              src={item.logoUrl}
              alt={item.title || 'Social'}
              class={imgClass}
            />
          ) : lowerTitle.includes('facebook') ? (
            <svg class={iconClass} fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          ) : lowerTitle.includes('instagram') ? (
            <svg class={iconClass} fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          ) : lowerTitle.includes('youtube') ? (
            <svg class={iconClass} fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          ) : lowerTitle.includes('behance') ? (
            <svg class={iconClass} fill="currentColor" viewBox="0 0 24 24">
              <path d="M22 7h-7v-2h7v2zm1.726 10c-.442 1.297-2.029 3-5.171 3-3.455 0-5.555-2.525-5.555-5.748 0-3.528 2.39-5.752 5.511-5.752 3.455 0 5.21 2.457 4.969 5.897h-7.795c.081 1.636 1.157 2.651 2.66 2.651 1.341 0 2.153-.618 2.502-1.548h2.879zm-7.947-4.148h5.056c-.085-1.393-.972-2.164-2.394-2.164-1.488 0-2.457.828-2.662 2.164zm-10.779 7.148h-5v-16h6.126c2.81 0 4.874 1.373 4.874 4.032 0 1.666-.889 2.946-2.28 3.559 1.83.607 2.78 2.146 2.78 4.092 0 2.808-2.246 4.317-6.5 4.317zm-2-6.5h2.89c1.47 0 2.36-.653 2.36-1.848 0-1.129-.79-1.752-2.36-1.752h-2.89v3.6zm0 4.5h3.04c1.68 0 2.71-.787 2.71-2.08 0-1.332-.98-2.02-2.71-2.02h-3.04v4.1z" />
            </svg>
          ) : lowerTitle.includes('linkedin') ? (
            <svg class={iconClass} fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
          ) : lowerTitle.includes('github') ? (
            <svg class={iconClass} fill="currentColor" viewBox="0 0 24 24">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              />
            </svg>
          ) : lowerTitle.includes('twitter') || lowerTitle === 'x' ? (
            <svg class={iconClass} fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          ) : lowerTitle.includes('dribbble') ? (
            <svg class={iconClass} fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.372 0 0 5.373 0 12s5.372 12 12 12 12-5.373 12-12S18.628 0 12 0zm9.885 11.441c-2.575-.422-4.943-.445-7.103-.073a42.153 42.153 0 00-.767-1.68c2.31-1 4.165-2.358 5.548-4.082a9.863 9.863 0 012.322 5.835zm-3.842-7.282c-1.205 1.554-2.868 2.783-4.986 3.68a46.287 46.287 0 00-3.488-5.438A9.894 9.894 0 0112 2.087c2.275 0 4.368.779 6.043 2.072zM7.527 3.166a44.59 44.59 0 013.537 5.381c-2.43.715-5.331 1.082-8.684 1.105a9.931 9.931 0 015.147-6.486zM2.087 12l.013-.256c3.849-.005 7.169-.448 9.95-1.322.233.475.456.952.67 1.432-3.38 1.057-6.165 3.222-8.337 6.48A9.865 9.865 0 012.087 12zm3.829 7.81c1.969-3.088 4.482-5.098 7.598-6.027a39.137 39.137 0 012.043 7.46c-3.349 1.291-6.953.666-9.641-1.433zm11.586.43a41.098 41.098 0 00-1.92-6.897c1.876-.265 3.94-.196 6.199.196a9.923 9.923 0 01-4.279 6.701z" />
            </svg>
          ) : (
            <svg class={iconClass} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          )}
        </a>
      );
    })}
  </div>
)}
