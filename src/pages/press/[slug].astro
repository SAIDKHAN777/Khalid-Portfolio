---
import '../../styles/global.css';
import Topbar from '../../components/Topbar.astro';
import prisma from '../../lib/db';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/press');
}

const post = await prisma.blogPost.findFirst({
  where: {
    slug,
    status: 'PUBLISHED',
    deletedAt: null,
  },
});

if (!post) {
  return Astro.redirect('/press');
}

// Format body paragraphs (split by double newline or render lines cleanly)
const paragraphs = post.content.split(/\n\s*\n/).filter((p) => p.trim().length > 0);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.title} | Khalid Press</title>
    <meta name="description" content={post.excerpt || post.title} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#FCFCFC] text-[#101014] antialiased selection:bg-[#101014] selection:text-white min-h-screen flex flex-col">
    <!-- Topbar Navigation -->
    <Topbar brandName="KHALID" />

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-6 md:px-12 lg:px-16 pt-24 md:pt-28 pb-24 space-y-10">
      <!-- Back Button -->
      <div class="flex items-center justify-between select-none border-b border-[#E2E2E6] pb-6">
        <a
          href="/press"
          id="article-back-button"
          class="inline-flex items-center gap-2 text-sm md:text-base font-semibold tracking-wide text-[#101014] hover:text-[#101014]/60 transition-all duration-200 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded px-2 py-1 cursor-pointer"
          aria-label="Back to Press"
          onclick="if (history.length > 1) { history.back(); return false; }"
        >
          <svg
            class="w-5 h-5 transition-transform duration-200 group-hover:-translate-x-1"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          <span>Back to Press</span>
        </a>

        {post.publishedAt && (
          <span class="text-xs font-mono text-neutral-400">
            {new Date(post.publishedAt).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </span>
        )}
      </div>

      <!-- Split Layout: Left Corner 9:16 Thumbnail, Right Side Headline & Article Body -->
      <div class="flex flex-col lg:flex-row items-start gap-10 lg:gap-14">
        <!-- 1. Left Column: 9:16 Portrait Thumbnail (বাম পাশের কোণায় থাম্বনেইল) -->
        <div class="w-full sm:w-80 lg:w-[340px] xl:w-[380px] shrink-0 lg:sticky lg:top-28 flex justify-center sm:block">
          <div class="aspect-[9/16] w-full max-w-[240px] sm:max-w-none rounded-3xl overflow-hidden bg-neutral-950 border border-neutral-200 shadow-2xl relative">
            {post.coverImageUrl ? (
              <img
                src={post.coverImageUrl}
                alt={post.title}
                class="w-full h-full object-cover"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-neutral-900 text-neutral-500 font-mono text-xs">
                Press Image (9:16)
              </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
          </div>
        </div>

        <!-- 2. Right Column: Headline & Article Content (থাম্বনেইলের পাশে হেডলাইন ও বিস্তারিত লেখা) -->
        <div class="flex-1 min-w-0 space-y-8">
          <!-- Headline Title (থাম্বনেইলের পাশে থেকে প্রথমে হেডলাইনটা শুরু হবে) -->
          <div class="space-y-4 border-b border-[#E2E2E6] pb-6">
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[#101014] leading-[1.15]">
              {post.title}
            </h1>
            <div class="flex items-center gap-3 text-xs font-mono text-neutral-500">
              <span class="px-2.5 py-1 rounded-full bg-neutral-100 text-neutral-700 font-semibold uppercase tracking-wider text-[10px]">
                Press Release
              </span>
              <span>•</span>
              <span>{post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : 'Editorial'}</span>
            </div>
          </div>

          <!-- Article Content (এর নিচে থেকে আর্টিকেল আকারে লেখাটা দেখাবে) -->
          <article class="space-y-6 text-base sm:text-lg md:text-xl text-slate-800 font-normal leading-relaxed">
            {paragraphs.map((p) => (
              <p class="whitespace-pre-line leading-relaxed">{p.trim()}</p>
            ))}
          </article>
        </div>
      </div>
    </main>
  </body>
</html>
