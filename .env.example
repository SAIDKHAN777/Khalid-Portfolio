# Application
NODE_ENV=development
SITE_URL=http://localhost:4321

# Local Prisma CLI SQLite path (runtime queries use the Cloudflare D1 binding "DB")
DATABASE_URL="file:./dev.db"

# Authentication and session signing
SESSION_SECRET="replace-with-a-64-char-hex-secret"
ADMIN_EMAIL="admin@khalid.dev"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Optional email delivery (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@khalid.dev"
