{
  "name": "khalid-portfolio",
  "version": "1.0.0",
  "description": "Full-stack portfolio and CMS built with Astro, TypeScript, Tailwind CSS, Prisma, and Cloudflare Workers with D1",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "astro dev",
    "build": "prisma generate && astro build",
    "preview": "astro build && astro preview",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate:local": "wrangler d1 migrations apply khalid-portfolio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply khalid-portfolio-db --remote"
  },
  "keywords": [
    "astro",
    "portfolio",
    "cloudflare-workers",
    "cloudflare-d1",
    "prisma",
    "typescript",
    "tailwindcss"
  ],
  "author": "Khalid",
  "license": "MIT",
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/react": "^7.1.9",
    "@prisma/adapter-d1": "^6.19.3",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "dotenv": "^18.0.10",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.1",
    "sanitize-html": "^2.18.2",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@prisma/client": "^6.19.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
